# Google Cloud project that has the Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Cloud Storage bucket holding uploaded bid packets.
PACKETS_BUCKET=

# Local development uses Application Default Credentials:
#   gcloud auth application-default login
# Cloud Run uses its attached service account, so leave this unset there.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Only these email domains may sign in.
ALLOWED_EMAIL_DOMAIN=nouveauelevator.com
